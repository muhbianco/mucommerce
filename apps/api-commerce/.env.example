# Copy to .env for local development. Production values live in the Portainer Env (${VAR}).
ENVIRONMENT=development
LOG_LEVEL=INFO
DOCS_ENABLED=true

# MariaDB (compose.dev.yml exposes 3307)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=mucommerce
DB_USER=mucommerce_app
DB_PASSWORD=app
MIGRATE_DB_USER=mucommerce_migrate
MIGRATE_DB_PASSWORD=migrate
RUN_MIGRATIONS_ON_STARTUP=false

# Redis / Celery (empty = in-memory cache + eager tasks)
REDIS_URL=redis://127.0.0.1:6380/4
CELERY_BROKER_URL=redis://127.0.0.1:6380/3
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/3

# Admin auth
JWT_SECRET=change-me-to-a-random-string-with-32-plus-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# Internal service tokens (one per consumer)
INTERNAL_TOKEN_WEB=dev-web-token
INTERNAL_TOKEN_TRAEFIK=dev-traefik-token
INTERNAL_TOKEN_AGENTS=dev-agents-token

# Tenant credentials at rest: openssl rand -base64 32
CREDENTIALS_MASTER_KEY=
CREDENTIALS_KEY_VERSION=1

# Platform / edge
PLATFORM_TENANT_SLUG=muhbianco
PLATFORM_BASE_DOMAIN=loja.muhbianco.com.br
PANEL_HOST=painel.muhbianco.com.br
API_PUBLIC_HOST=api-commerce.muhbianco.com.br
EDGE_CNAME_TARGET=edge.muhbianco.com.br
EDGE_PUBLIC_IPS=
EDGE_WEB_UPSTREAM=http://commerce-web:3000
EDGE_API_UPSTREAM=http://commerce-api:8000
CHATWOOT_PUBLIC_URL=https://chatwoot.muhbianco.com.br

# Observability
SENTRY_DSN=
METRICS_ENABLED=true

# CLI bootstrap (python -m app.cli admin bootstrap)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
