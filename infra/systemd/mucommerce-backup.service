[Unit]
Description=Backup cifrado das lojas (banco e mídia) para o Backblaze B2
Documentation=https://github.com/muhbianco/mucommerce/blob/main/infra/backup/b2-backup.sh
After=network-online.target docker.service mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/src/mucommerce/infra/backup/b2-backup.sh
# O script já usa nice/ionice no que pesa; isto cobre o resto do processo.
Nice=19
IOSchedulingClass=idle
# Falha de backup não pode passar em silêncio: fica no journal com o código de saída.
StandardOutput=journal
StandardError=journal
TimeoutStartSec=45min

[Install]
WantedBy=multi-user.target
